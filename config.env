# MKhaliFa Meme Lab settings (paper only). The numbers here are the rules written before any result.
DATA_DIR=/opt/mkhalifa-meme-lab/data
SUMMARY_PATH=/opt/mkhalifa-meme-lab/data/summary.json
MIN_AGE_MIN=10
MIN_LIQ_USD=40000
MAX_TOP10_PCT=25
MAX_DEV_PCT=5
MAX_H1_PCT=80
TICKET_USD=50
FEE_PCT=1.0
STOP_PCT=6
TRAIL_START_PCT=20
TRAIL_PCT=12
TIMEOUT_H=3
# optional, later: a free Helius key gives a faster RPC (read-only). Leave empty for the public one.
RPC_URL=https://api.mainnet-beta.solana.com
